---
import '../styles/global.css';
import DownloadButton from '../components/DownloadButton.astro';
import WorldMap from '../components/WorldMap.astro';
const navigation = [['home', 'Главная'], ['map', 'Карта'], ['credits', 'Авторы и права']];
const artworks = [
 { src: '/images/retro-heroes.png', alt: 'Герои FusionFall против армии Фьюза — арт FusionFall Retro', width: 1920, height: 620 },
 { src: '/images/legacy-eddy.png', alt: 'Эдди — иллюстрация FusionFall Legacy', width: 620, height: 234 },
 { src: '/images/legacy-zoocrew.png', alt: 'Бумер, Бабблс и Джеки Хонес — иллюстрация FusionFall Legacy', width: 620, height: 234 },
];

---
<!doctype html>
<html lang="ru">
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="theme-color" content="#003b55" />
 <meta name="description" content="Русский фанатский сайт FFOne: мир FusionFall, информация о проекте и будущая загрузка клиента." />
 <title>FFOne — фанатский проект FusionFall</title>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 <link rel="preload" href="/fonts/jeffe.otf" as="font" type="font/otf" crossorigin />
</head>
<body>
 <a class="skip-link" href="#main">Перейти к содержимому</a>
 <div class="wrapper">
  <header class="header"><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Меню</button></header>
  <div class="columns">
   <aside class="left-side">
    <a class="logo-link" href="#home" aria-label="FFOne — главная"><img src="/images/ffone-logo.png" alt="FFOne" width="2058" height="764" /></a>
    <div class="navigation-panel"><h2 class="navigation-title"><span>Навигация</span></h2><nav id="site-navigation" aria-label="Основная навигация">{navigation.map(([id,label]) => <a href={`#${id}`} class:list={['nav-link',{active:id==='home'}]} aria-current={id==='home'?'page':undefined}>{label}</a>)}</nav><div class="navigation-bottom" aria-hidden="true"></div></div>
    <div class="sidebar-download"><DownloadButton compact /><span id="download-status" class="sr-only">Загрузка пока не открыта.</span></div>
   </aside>
   <main id="main" tabindex="-1">
    <section class="page-view" data-view="home" aria-label="Главная">
     <h1 class="sr-only">FFOne — фанатский проект FusionFall</h1>
     <div class="banner-frame"><button type="button" class="slider-arrow previous" aria-label="Предыдущий арт"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button><div class="artwork-stage">{artworks.map((art, index) => <img class="artwork" src={art.src} alt={art.alt} width={art.width} height={art.height} hidden={index !== 0} fetchpriority={index === 0 ? 'high' : 'auto'} />)}</div><button type="button" class="slider-arrow next" aria-label="Следующий арт"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button></div>
     <div class="artwork-controls" role="group" aria-label="Арты FusionFall">{artworks.map((art, index) => <button type="button" data-artwork={index} aria-label={`Показать: ${art.alt}`} aria-pressed={index === 0} class:list={['artwork-dot', { selected: index === 0 }]}></button>)}</div>
    </section>
    <WorldMap />
    <section class="page-view content-panel full-panel" data-view="credits" hidden><h1 class="panel-title">Об авторах и правах</h1><div class="panel-body article-body"><p>FFOne — независимый фанатский проект. Он не связан с Cartoon Network или правообладателями FusionFall.</p><p>FusionFall и связанные персонажи принадлежат их правообладателям.</p></div><div class="panel-bottom"></div></section>
    <noscript><style>.page-view[hidden]{display:block!important;margin-top:24px}</style><p>Все разделы доступны ниже.</p></noscript>
   </main>
  </div>
  <footer><p>FFOne — независимый фанатский проект по мотивам FusionFall, не связанный с Cartoon Network.<br />FusionFall и связанные персонажи принадлежат их правообладателям.</p></footer>
 </div>
 <script>
  const artImages = document.querySelectorAll<HTMLImageElement>('.artwork');
  const artButtons = document.querySelectorAll<HTMLButtonElement>('[data-artwork]');
  let selectedArt = 0;
  function selectArt(index: number) {
   selectedArt = (index + artImages.length) % artImages.length;
   artImages.forEach((image, imageIndex) => image.hidden = imageIndex !== selectedArt);
   artButtons.forEach((item, itemIndex) => { item.setAttribute('aria-pressed', String(itemIndex === selectedArt)); item.classList.toggle('selected', itemIndex === selectedArt); });
  }
  artButtons.forEach((button, index) => button.addEventListener('click', () => selectArt(index)));
  document.querySelector('.slider-arrow.previous')?.addEventListener('click', () => selectArt(selectedArt - 1));
  document.querySelector('.slider-arrow.next')?.addEventListener('click', () => selectArt(selectedArt + 1));
  const views = document.querySelectorAll<HTMLElement>('[data-view]');
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-navigation');
  function showPage(focus = false) {
   const requested = location.hash.slice(1) || 'home';
   const current = Array.from(views).some(view=>view.dataset.view===requested) ? requested : 'home';
   views.forEach(view=>view.hidden=view.dataset.view!==current);
   links.forEach(link=>{const active=link.hash===`#${current}`;link.classList.toggle('active',active);if(active)link.setAttribute('aria-current','page');else link.removeAttribute('aria-current');});
   nav?.classList.remove('is-open');toggle?.setAttribute('aria-expanded','false');
   if(focus){document.querySelector<HTMLElement>('#main')?.focus({preventScroll:true});window.scrollTo({top:0});}
  }
  toggle?.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(expanded));nav?.classList.toggle('is-open',expanded);});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){nav?.classList.remove('is-open');toggle?.setAttribute('aria-expanded','false');}});
  window.addEventListener('hashchange',()=>showPage(true));showPage();
 </script>
</body>
</html>
